# Integration tests. Copy to .env.test (gitignored). Used by docker-compose.test.yml
# and the test scripts. Test credentials and ports never overlap with development.

NODE_ENV=test
LOG_LEVEL=silent

# Images: same as development (decision 007). docker-compose.test.yml runs with
# --env-file .env.test, so it can't read these from .env.
POSTGRES_IMAGE=postgres:18.6-bookworm
TEST_REDIS_IMAGE=valkey/valkey:9.1.2-alpine

# Test PostgreSQL (docker-compose.test.yml)
TEST_DB_PORT=5441
TEST_DB_USER=helmrun_test
TEST_DB_PASSWORD=helmrun-test-only
TEST_DB_NAME=helmrun_test
TEST_DATABASE_URL=postgresql://helmrun_test:helmrun-test-only@127.0.0.1:5441/helmrun_test

# Test Valkey, Redis-compatible (docker-compose.test.yml)
TEST_REDIS_PORT=6391
TEST_REDIS_PASSWORD=helmrun-test-only
TEST_REDIS_URL=redis://:helmrun-test-only@127.0.0.1:6391

{
  "name": "helmrun",
  "version": "0.0.0",
  "private": true,
  "description": "Distributed platform for running AI agents reliably",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.27.1"
  },
  "scripts": {
    "dev": "pnpm --filter @helmrun/api dev",
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "db:migrate": "pnpm --filter @helmrun/database migrate:up",
    "db:migrate:create": "pnpm --filter @helmrun/database migrate:create",
    "db:migrate:test": "pnpm --filter @helmrun/database migrate:test:up",
    "openapi:generate": "pnpm --filter @helmrun/api openapi:generate",
    "openapi:check": "pnpm openapi:generate && { git diff --exit-code -- apps/api/openapi.json && git ls-files --error-unmatch apps/api/openapi.json > /dev/null 2>&1 || { echo 'apps/api/openapi.json is stale or untracked: run pnpm openapi:generate and commit it' >&2; exit 1; }; }",
    "test:stack": "docker compose -f docker-compose.test.yml --env-file .env.test up -d --wait && pnpm db:migrate:test",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm openapi:check && pnpm test && pnpm build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,js}": "eslint --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

{
  "name": "helmrun",
  "version": "0.0.0",
  "private": true,
  "description": "Distributed platform for running AI agents reliably",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.27.1"
  },
  "scripts": {
    "dev": "pnpm --filter @helmrun/api dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "db:migrate": "pnpm --filter @helmrun/database migrate:up",
    "db:migrate:create": "pnpm --filter @helmrun/database migrate:create",
    "db:migrate:test": "pnpm --filter @helmrun/database migrate:test:up",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

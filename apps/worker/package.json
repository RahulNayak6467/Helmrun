{
  "name": "@helmrun/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Helmrun worker process (shell until phase 3)",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=@helmrun/source --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --passWithNoTests apps/worker/"
  },
  "dependencies": {
    "@helmrun/config": "workspace:*",
    "@helmrun/logger": "workspace:*",
    "@helmrun/shared": "workspace:*",
    "zod": "catalog:"
  }
}

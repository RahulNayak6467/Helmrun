# Local development. Copy to .env (gitignored). Every app reads this file and
# validates only the variables its own src/config.ts schema declares.
# Names below are a starting point: the app config schemas are the source of truth.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# API (apps/api only)
PORT=8010
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=20000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL (docker-compose.yml). Ports chosen to avoid clashing with other local projects.
POSTGRES_IMAGE=postgres:18.6-bookworm
DB_PORT=5440
DB_USER=helmrun
DB_PASSWORD=helmrun-local-only
DB_NAME=helmrun_dev
DATABASE_URL=postgresql://helmrun:helmrun-local-only@127.0.0.1:5440/helmrun_dev
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_READINESS_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=15000

# Valkey, Redis-compatible (docker-compose.yml). Password required, like ElastiCache.
# Keep REDIS_URL out of logs: it contains the password.
REDIS_IMAGE=valkey/valkey:9.1.2-alpine
REDIS_PORT=6390
REDIS_PASSWORD=helmrun-local-only
REDIS_URL=redis://:helmrun-local-only@127.0.0.1:6390
